# ---------------------------------------------------------------------------
# SERVER-SIDE ONLY. Never prefix these with REACT_APP_.
#
# Create React App inlines every REACT_APP_* variable into the public JS
# bundle, so a REACT_APP_GEMINI_API_KEY is readable by anyone who opens the
# deployed site. All Gemini and database traffic goes through the serverless
# functions in api/ instead.
# ---------------------------------------------------------------------------

# Gemini API key used by api/gemini.js and api/analyze.js
GEMINI_API_KEY=your_server_side_gemini_api_key_here

# Postgres connection string with the pgvector extension available.
# Use the POOLED connection string (Neon "-pooler" host, Supabase port 6543);
# serverless functions open many short-lived connections.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional tuning for the semantic memory layer
MEMORY_TOP_K=5                    # how many past entries to retrieve per analysis
MEMORY_MIN_SIMILARITY=0.55        # cosine floor; below this an entry is not "related"
RECOMMENDATION_DEDUPE_THRESHOLD=0.85  # cosine above which a suggestion counts as a repeat
